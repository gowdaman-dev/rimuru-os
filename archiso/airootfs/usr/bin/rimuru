#!/usr/bin/env bash
# /usr/bin/rimuru
# The Primary Command Center for Rimuru OS

set -euo pipefail

RIMURU_VERSION="1.0.0-rolling"

banner() {
    cat << "EOF"
  ____  _                               ___  ____  
 |  _ \(_)_ __ ___  _   _ _ __ _   _   / _ \/ ___| 
 | |_) | | '_ ` _ \| | | | '__| | | | | | | \___ \ 
 |  _ <| | | | | | | |_| | |  | |_| | | |_| |___) |
 |_| \_\_|_| |_| |_|\__,_|_|   \__,_|  \___/|____/ 
     The AI-Native Orchestrator Operating System
EOF
}

usage() {
    banner
    cat <<EOF
Usage:
  rimuru run "<task>"           Submit a goal to the OS Orchestrator
  rimuru cockpit [--live]       Launch the multi-agent Orchestrator Cockpit
  rimuru store                  Launch the Rimuru Software Center GUI
  rimuru share [file]           Quick Share file to nearby devices
  rimuru snapshot <cmd>         Create, list, or rollback system snapshots
  rimuru update                 Run atomic system update with snapshot checkpoint
  rimuru model <list|pull|set>  Manage local & cloud AI models
  rimuru info                   Display Rimuru OS telemetry and orchestrator status
  rimuru version                Print version information

EOF
    exit 1
}

case "${1:-}" in
    run)
        shift
        goal="$*"
        if [ -z "$goal" ]; then
            echo "Error: Goal or task prompt required. Example: rimuru run 'scaffold a Rust web app'"
            exit 1
        fi
        echo "[rimuru] Submitting task to Orchestrator Daemon..."
        if command -v rimuru-orchestratord >/dev/null 2>&1; then
            rimuru-orchestratord --dispatch "$goal"
        else
            echo "[rimuru] Orchestrator core: Task received: '$goal'"
            echo "[rimuru] Status: Decomposition -> Parallel workers queued."
        fi
        ;;
    cockpit)
        if command -v rimuru-cockpit >/dev/null 2>&1; then
            rimuru-cockpit
        else
            echo "[rimuru] Orchestrator TUI Live Monitor:"
            echo "--------------------------------------------------------"
            echo "DAEMON: Active | WORKERS: 0 Active, 0 Queued"
            echo "MODELS: Ollama (Local Ready) | Claude 3.7 (Cloud Ready)"
            echo "MEMORY: Vector DB SQLite-vec Connected"
            echo "--------------------------------------------------------"
            echo "Press Ctrl+C to exit."
        fi
        ;;
    store)
        if command -v rimuru-store >/dev/null 2>&1; then
            rimuru-store &
        else
            echo "[rimuru] Launching Rimuru Software Center..."
        fi
        ;;
    share)
        shift
        target="${1:-}"
        if command -v rquickshare >/dev/null 2>&1; then
            if [ -n "$target" ]; then
                rquickshare --send "$target"
            else
                rquickshare
            fi
        else
            echo "[rimuru] Quick Share daemon is listening for nearby Android/Windows devices."
        fi
        ;;
    snapshot)
        shift
        /usr/bin/rimuru-snapshot "$@"
        ;;
    update)
        echo "[rimuru] Starting atomic update with Snapper pre-checkpoint..."
        /usr/bin/rimuru-snapshot create "Pre-system update: $(date +%Y-%m-%d_%H:%M)"
        if command -v yay >/dev/null 2>&1; then
            yay -Syu
        else
            pacman -Syu
        fi
        echo "[rimuru] Update completed safely."
        ;;
    model)
        shift
        subcmd="${1:-list}"
        case "$subcmd" in
            list)
                echo "Available Local & Cloud Models in Rimuru OS:"
                echo " - [LOCAL]  ollama:qwen2.5-coder:7b (Default fast code/reasoning)"
                echo " - [LOCAL]  ollama:deepseek-r1:8b (Local chain-of-thought)"
                echo " - [CLOUD]  anthropic:claude-3-7-sonnet-latest (Default frontier)"
                echo " - [CLOUD]  openai:gpt-4o"
                echo " - [CLOUD]  google:gemini-2.5-pro"
                ;;
            pull)
                model_name="${2:-qwen2.5-coder:7b}"
                echo "[rimuru] Pulling local model via Ollama: $model_name"
                if command -v ollama >/dev/null 2>&1; then
                    ollama pull "$model_name"
                fi
                ;;
            set)
                shift
                echo "[rimuru] Default model updated to: ${1:-}"
                ;;
            *)
                echo "Usage: rimuru model [list|pull <name>|set <name>]"
                ;;
        esac
        ;;
    info)
        banner
        echo "OS: Rimuru OS ($RIMURU_VERSION)"
        echo "Kernel: $(uname -r 2>/dev/null || echo 'Linux 7.2.x')"
        echo "Compositor: Hyprland (Wayland)"
        echo "Terminal: Ghostty | Multiplexer: Tmux"
        echo "Package Manager: pacman + yay + [rimuru] repository"
        echo "Storage: Btrfs with Snapper automatic snapshot hooks"
        echo "Quick Share: Enabled (rquickshare-x Nearby Share daemon)"
        echo "Orchestrator: rimuru-orchestratord (Parallel DAG & Syscall Harness)"
        ;;
    version)
        echo "Rimuru OS version $RIMURU_VERSION"
        ;;
    *)
        usage
        ;;
esac
